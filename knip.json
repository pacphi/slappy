{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/pages/**/*.vue",
    "server/api/**/*.ts",
    "cli/**/*.ts",
    "tests/*.test.ts",
    "scripts/*.mjs"
  ],
  "project": [
    "app/**/*.{ts,vue}",
    "server/**/*.ts",
    "lib/**/*.ts",
    "cli/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.mjs",
    "app/**/*.css"
  ],
  "ignore": [],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@iconify-json/heroicons",
    "@iconify-json/lucide",
    "eslint-config-prettier",
    "eslint-plugin-prettier",
    "typescript-eslint"
  ],
  "nuxt": {
    "entry": ["nuxt.config.ts", "app.config.ts"]
  }
}
