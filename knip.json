{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["app/pages/**/*.vue", "server/api/**/*.ts", "cli/**/*.ts"],
  "project": ["app/**/*.{ts,vue}", "server/**/*.ts", "lib/**/*.ts", "cli/**/*.ts"],
  "ignore": ["app/components/**", "app/composables/**"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "date-fns",
    "@iconify-json/heroicons",
    "@iconify-json/lucide",
    "eslint-config-prettier",
    "eslint-plugin-prettier",
    "typescript-eslint"
  ],
  "nuxt": {
    "entry": ["nuxt.config.ts", "app.config.ts"]
  }
}
