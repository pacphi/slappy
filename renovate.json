{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Managed from pacphi/mise-dotfiles. Replaces Dependabot version updates (2026-10-21).",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "npm: dev commit prefix",
      "matchCategories": [
        "js"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "commitMessagePrefix": "chore:"
    },
    {
      "description": "npm: settings",
      "matchCategories": [
        "js"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ],
      "labels": [
        "dependencies",
        "pnpm"
      ],
      "commitMessagePrefix": "chore:"
    },
    {
      "description": "npm: group development-dependencies",
      "matchCategories": [
        "js"
      ],
      "groupName": "development-dependencies",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchDepTypes": [
        "devDependencies"
      ]
    },
    {
      "description": "npm: group production-dependencies",
      "matchCategories": [
        "js"
      ],
      "groupName": "production-dependencies",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchDepTypes": [
        "dependencies"
      ]
    },
    {
      "description": "github-actions: settings",
      "matchCategories": [
        "ci"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ],
      "labels": [
        "dependencies",
        "github-actions"
      ],
      "commitMessagePrefix": "ci:"
    }
  ],
  "prConcurrentLimit": 15
}
