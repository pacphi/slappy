{
  "name": "slappy",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "NODE_NO_WARNINGS=1 nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,js,json,css,md}\"",
    "deadcode": "knip",
    "check:all": "pnpm lint && pnpm format:check && pnpm deadcode",
    "fix:all": "pnpm lint:fix && pnpm format",
    "outdated": "pnpm outdated",
    "update": "pnpm up",
    "update:latest": "pnpm up --latest",
    "update:interactive": "pnpm up --interactive --latest",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix",
    "cli": "tsx cli/nametag-generator.ts",
    "test:local": "tsx cli/test-local.ts"
  },
  "dependencies": {
    "@nuxt/ui": "^4.10.0",
    "@pinia/colada": "^1.4.2",
    "@pinia/colada-nuxt": "^1.0.2",
    "@pinia/nuxt": "^0.11.3",
    "date-fns": "^4.4.0",
    "nuxt": "^4.5.0",
    "nuxt-feature-flags": "1.1.7",
    "pinia": "^3.0.4",
    "puppeteer": "^25.3.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.109",
    "@nuxt/eslint": "^1.15.2",
    "@nuxtjs/seo": "^5.1.3",
    "@types/node": "^25.9.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "knip": "^6.14.2",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint": "10"
      }
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "puppeteer",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ],
    "overrides": {
      "@types/parse-path": "npm:empty-npm-package@^1.0.0",
      "@vue/devtools-kit": "8.0.3",
      "@vue/devtools-api": "8.0.3",
      "@vue/devtools-core": "8.0.3",
      "node-forge": ">=1.4.0",
      "devalue": ">=5.6.2",
      "fast-xml-parser": ">=5.3.5",
      "simple-git": ">=3.32.3",
      "tar": ">=7.5.8",
      "@isaacs/brace-expansion": ">=5.0.1",
      "defu": ">=6.1.5",
      "diff": ">=8.0.3",
      "flatted": ">=3.4.2",
      "h3": ">=1.15.9",
      "lodash": ">=4.18.0",
      "postcss": ">=8.5.10",
      "rollup": ">=4.59.0",
      "smol-toml": ">=1.6.1",
      "unhead": ">=2.1.13",
      "ws": ">=8.20.1",
      "yaml": ">=2.8.3",
      "eslint-plugin-import-x>minimatch": ">=10.2.3",
      "readdir-glob>minimatch": ">=5.1.8",
      "glob>minimatch": ">=9.0.7",
      "tinyglobby>picomatch": ">=4.0.4",
      "anymatch>picomatch": "^2.3.2",
      "micromatch>picomatch": "^2.3.2",
      "@stylistic/eslint-plugin>picomatch": "^4.0.4",
      "unplugin>picomatch": "^4.0.4",
      "unimport>picomatch": "^4.0.4",
      "unplugin-utils>picomatch": "^4.0.4",
      "unplugin-auto-import>picomatch": "^4.0.4",
      "unplugin-vue-components>picomatch": "^4.0.4",
      "@rollup/pluginutils>picomatch": "^4.0.4"
    }
  }
}
